# Copy to .env.local (gitignored) and fill in. Never commit real values here.

# i18nexus project API key. Read-only: it is what `npm run i18n:pull` and
# `npm run i18n:listen` use to download translations.
I18NEXUS_API_KEY=

# Personal access token. Write access to the i18nexus project, so it is only
# needed by `npm run i18n:import` and the other push commands — leave it empty
# on any machine that only pulls.
I18NEXUS_PERSONAL_ACCESS_TOKEN=

# Contact form (modules/contact/actions.ts, delivery.ts, guard.ts). Without
# RESEND_API_KEY or the Telegram pair the form cannot send and offers the
# visitor's mail app instead.
#
# Resend API key (resend.com → API Keys), with sending access.
RESEND_API_KEY=
# Sender on the domain verified in Resend, e.g. MIW Labs <hello@myinventionworld.com>.
# Also turns on the confirmation to the visitor. Without it Resend's shared
# sender is used, which delivers only to the Resend account owner.
CONTACT_FROM=
# Who gets enquiries; comma-separated for several. Default: CONTACT_EMAIL from
# modules/contact/contact.ts.
CONTACT_TO=
# Optional Telegram copy of every enquiry: a bot token from @BotFather and the
# chat id it should write to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Cloudflare Turnstile (dash.cloudflare.com → Turnstile), both or
# neither. The site key is built into the page, so changing it needs a redeploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The site's own address once there is a domain, e.g. https://miw.example.
# Until then Vercel's production hostname is used (lib/site.ts).
NEXT_PUBLIC_SITE_URL=
